# Copiar a .env y completar. .env está en .gitignore: nunca se commitea.

# --- Base de datos ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/infinia
# Railway exige SSL; en local se deja vacío.
PGSSLMODE=

# --- Servidor ---
PORT=3000

# --- Panel admin ---
# Solo se usan una vez, al arrancar el server por primera vez contra una base
# vacía: crean la primera cuenta (rol Admin) en la tabla `usuarios`. Después
# de eso, las cuentas se administran desde /admin/cuentas y estas variables
# ya no hacen nada — no sirven para "resetear" la contraseña de esa cuenta.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-clave
SESSION_SECRET=cambiar-este-secreto

# --- Envío de cotizaciones por correo (opcional) ---
# Sin estas variables el panel deshabilita el botón "Enviar por correo" y lo
# avisa; imprimir y descargar el PDF siguen funcionando igual.
# Con Gmail / Google Workspace hay que usar una "app password", no la clave
# normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cotizaciones@infinia.pe
SMTP_PASS=
# Remitente que ve el cliente. Si se omite, se usa SMTP_USER.
SMTP_FROM=Infinia <cotizaciones@infinia.pe>
